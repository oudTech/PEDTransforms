# Copy this file to .env.local and fill in the values.
# Sanity project settings: https://www.sanity.io/manage

# --- Public (exposed to the browser) ---------------------------------------

# Project ID from sanity.io/manage -> your project
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset name, usually "production"
NEXT_PUBLIC_SANITY_DATASET=production

# Content Lake API version (YYYY-MM-DD)
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01

# Public URL of this site, used for metadata, sitemap and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (never exposed to the browser) ----------------------------

# Viewer token: sanity.io/manage -> API -> Tokens -> Add API token (Viewer).
# Needed for draft previews and private datasets.
SANITY_API_READ_TOKEN=

# Editor token, only needed to run `npm run sanity:seed`.
SANITY_API_WRITE_TOKEN=

# Any long random string. Use the same value as the secret on the Sanity
# GROQ webhook pointing at /api/revalidate.
SANITY_REVALIDATE_SECRET=

# --- Contact form (Resend, server only) ------------------------------------

# API key from resend.com/api-keys (starts with "re_")
RESEND_API_KEY=

# Inbox that receives website enquiries
CONTACT_TO_EMAIL=

# Sender address on a domain verified in Resend, e.g. website@yourdomain.com.
# Emails always show "PEDTransforms" as the sender name.
CONTACT_FROM_EMAIL=

# --- Contact form bot check (Cloudflare Turnstile, optional but recommended) --

# From dash.cloudflare.com -> Turnstile -> Add widget (mode: Managed). Add your
# domain(s), plus "localhost" for local testing. Set both keys to enable the
# check; leave both empty to turn it off. Redeploy after changing them.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Live chat (Smartsupp, optional) ---------------------------------------

# "true" shows the chat widget on the website, "false" hides it.
# Redeploy after changing this so the pages and security policy update.
SMARTSUPP_ENABLED=false

# Key from the Smartsupp install snippet (_smartsupp.key = '...')
SMARTSUPP_KEY=

# --- Search engine verification (optional) ---------------------------------

# Token only (the "content" value of the meta tag), not the whole tag
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Deployment (optional) -------------------------------------------------

# Stable key for Server Action encryption when running more than one instance.
# Generate with: openssl rand -base64 32, then uncomment.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
